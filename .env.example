# KarunaGrid Environment Configuration Example

# Django Backend Configuration
SECRET_KEY=django-insecure-karunagrid-phase1-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*

# PostgreSQL Database Configuration
DB_NAME=karunagrid_db
DB_USER=karunagrid_user
DB_PASSWORD=karunagrid_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Google OAuth 2.0 Client ID (Backend Server-side Token Verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vite Frontend Configuration (Exposed to browser client for Google Identity Services)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=karunagrid@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=karunagrid@gmail.com
