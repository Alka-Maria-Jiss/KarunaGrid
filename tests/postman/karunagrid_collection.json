{
  "info": {
    "name": "KarunaGrid API Automated Regression Suite",
    "_postman_id": "karunagrid-api-tests-001",
    "description": "Automated API regression tests for KarunaGrid Healthcare & Palliative Network API using Postman & Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "doctorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - API Root Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('API is online and healthy', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('online');",
              "    pm.expect(jsonData.project).to.include('KarunaGrid');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Doctor Login & Token Acquisition",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"doctor@karunagrid.org\",\n    \"password\": \"Doctor@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Doctor login status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns JWT access and refresh tokens', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access');",
              "    pm.expect(jsonData).to.have.property('refresh');",
              "    pm.expect(jsonData.user.role).to.eql('Doctor');",
              "    pm.collectionVariables.set('doctorToken', jsonData.access);",
              "    pm.collectionVariables.set('refreshToken', jsonData.refresh);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Doctor Profile Verification (/api/me/)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK for Authenticated Doctor', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns Doctor identity correctly', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.email).to.eql('doctor@karunagrid.org');",
              "    pm.expect(jsonData.role).to.eql('Doctor');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Doctor Dashboard Metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/doctor/dashboard/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctor", "dashboard", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK for Doctor Dashboard', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Dashboard payload contains metrics or profile information', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Doctor Assigned Patients List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/doctor/patients/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctor", "patients", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK for Patient List', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array of patients', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Admin Login & Token Acquisition",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"admin@karunagrid.org\",\n    \"password\": \"Admin@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns Admin token and profile', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access');",
              "    pm.expect(jsonData.user.role).to.eql('Admin');",
              "    pm.collectionVariables.set('adminToken', jsonData.access);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Admin System Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/stats/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "stats", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK for Admin Stats', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns system overview statistics', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Admin User List Query",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "users", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK for Admin Users list', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is a list or paginated list of users', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.satisfy(function(data) {",
              "        return Array.isArray(data) || (data && Array.isArray(data.results));",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Security: Unauthenticated Access Denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/me/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401 Unauthorized for missing token', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Token Refresh Rotation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"refresh\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/token/refresh/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "token", "refresh", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK on token refresh', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('New access token is issued', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
